{
  "name": "mira",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --watch server/src/index.ts & npm --prefix web run dev; wait",
    "server": "node server/src/index.ts",
    "build:web": "npm --prefix web ci && npm --prefix web run build",
    "start": "node server/src/index.ts",
    "typecheck": "npm run typecheck --workspaces && tsc -p video/tsconfig.json",
    "test": "npm run test --workspaces",
    "e2e": "node scripts/e2e.ts",
    "cash:faucet": "node scripts/cash-faucet.ts",
    "docs:links": "node scripts/check-links.ts",
    "secrets:history": "node scripts/scan-history.ts",
    "video:shots": "node video/shots.ts",
    "video": "node video/render.ts"
  },
  "workspaces": [
    "packages/*",
    "server"
  ],
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "playwright": "^1.64.1"
  }
}
