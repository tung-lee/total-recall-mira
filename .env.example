# Copy to .env and fill it in. Never commit .env: the repo is public, so a pushed key is already leaked.
# Blank values count as unset. Without the keys below the server runs in preview mode (ADR-0006): memory on
# an in-process mock, pockets on a simulated ledger, and the header says "preview".

PORT=8787
# "1" forces preview mode even when keys are set. Tests and `npm run e2e` set it.
MIRA_PREVIEW=

# ── Walrus Memory on mainnet (packages/memory): the submitter's account, from memory.walrus.xyz.
MEMWAL_ACCOUNT_ID=
# The delegate key, 64 hex. Its public key is the form's MEMWAL_AGENT_ID.
MEMWAL_PRIVATE_KEY=
MEMWAL_SERVER_URL=https://relayer.memory.walrus.xyz
# From the relayer's GET /config, not the docs: a second mainnet deployment supersedes the docs' ids.
MEMWAL_PACKAGE_ID=0xe7c16fbea0560e7057e2bf7422feaa4fb313749fc69c9e9092fac7a33b81d7f5
MEMWAL_REGISTRY_ID=0x8bf82c9e09e36b8d1c38298f68b7cb68e7b8762887e7592add9986d5e9cf199f
MEMWAL_NETWORK=mainnet

# ── Mira Cash on Sui testnet (ADR-0004). Every call goes through Tatum (packages/chain, gRPC only).
# The submitter's Tatum key for testnet, from dashboard.tatum.io. Its account ID goes on the hackathon form.
TATUM_API_KEY_TESTNET=
TATUM_SUI_GRPC_TESTNET=https://sui-testnet-grpc.gateway.tatum.io
# Where Sui calls go while Tatum answers 402. Blank: the public fullnode. "off": none.
SUI_GRPC_FALLBACK_TESTNET=
# The testnet key that sponsors gas and seeds test cash (suiprivkey1…). Top it up with `npm run cash:faucet`.
SUI_OPERATOR_KEY=
# Derives every pocket's key. At least 32 characters; never change it once users exist.
MIRA_WALLET_SECRET=
# Test cash for a new user, in cents, and how many new users get it per hour.
MIRA_SEED_CENTS=10000
MIRA_SEEDS_PER_HOUR=30
